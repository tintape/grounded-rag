# Required: an OpenAI key, or a key for any OpenAI-compatible provider
OPENAI_API_KEY=sk-...
# Optional: leave empty for OpenAI. For OpenRouter use https://openrouter.ai/api/v1
# and prefix model names with the provider, e.g. openai/gpt-4.1-mini
OPENAI_BASE_URL=

# Models
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vector store: QDRANT_URL for a server (docker compose sets it), or QDRANT_PATH for embedded local mode
QDRANT_URL=
QDRANT_PATH=.qdrant_local
QDRANT_COLLECTION=documents
# Only for a managed/remote Qdrant that requires a key
QDRANT_API_KEY=

# Retrieval & grounding
TOP_K=5
MIN_RELEVANCE=0.30
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Ingestion
PDF_DIR=data/sample_pdfs

# UI -> API
API_URL=http://localhost:8000
# Optional: when set, POST /chat requires the header X-API-Key (the UI sends it automatically)
API_KEY=
