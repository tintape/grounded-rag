# Required
OPENAI_API_KEY=sk-...

# Models
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vector store: QDRANT_URL for a server (docker compose sets it), or QDRANT_PATH for embedded local mode
QDRANT_URL=
QDRANT_PATH=.qdrant_local
QDRANT_COLLECTION=documents

# Retrieval & grounding
TOP_K=5
MIN_RELEVANCE=0.30
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Ingestion
PDF_DIR=data/sample_pdfs

# UI -> API
API_URL=http://localhost:8000
